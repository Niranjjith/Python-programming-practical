def add(a, b):
    return a + b

def subtract(a, b):
    return a - b

def multiply(a, b):
    return a * b

def divide(a, b):
    if b != 0:
        return a / b
    else:
        return "Cannot divide by zero"





import mymath

num1 = 10
num2 = 5

print("Addition:", mymath.add(num1, num2))
print("Subtraction:", mymath.subtract(num1, num2))
print("Multiplication:", mymath.multiply(num1, num2))
print("Division:", mymath.divide(num1, num2))
